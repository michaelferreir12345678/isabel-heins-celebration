# Copie este arquivo para .env.local e preencha (veja docs/confirmacao-de-presenca.md).
# Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.

# ID da planilha: o trecho entre /d/ e /edit no endereço dela.
GOOGLE_SHEETS_ID=

# "client_email" do arquivo JSON da conta de serviço.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# "private_key" do arquivo JSON, entre aspas, do jeito que aparece lá (com os \n).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Endereço público do site, usado nos links personalizados de cada convite.
SITE_URL=https://isabel-e-heins.vercel.app
